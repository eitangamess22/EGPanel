generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum ServerType {
  MINECRAFT_JAVA
  DISCORD_NODE
  DISCORD_PYTHON
}

enum ServerState {
  OFFLINE
  STARTING
  RUNNING
  STOPPING
  CRASHED
  INSTALLING
  TRANSFERRING
  SUSPENDED
}

enum VariableType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  PASSWORD
}

enum BackupStorage {
  LOCAL
  S3
}

enum BackupState {
  CREATING
  AVAILABLE
  FAILED
  DELETING
  RESTORING
}

enum ScheduleTaskType {
  POWER_START
  POWER_STOP
  POWER_RESTART
  COMMAND
  BACKUP
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique @db.VarChar(320)
  username         String    @unique @db.VarChar(64)
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  roles            String[]  @default([])
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  suspendedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ownedServers     Server[]          @relation("ServerOwner")
  sessions         Session[]
  apiKeys          ApiKey[]
  subusers         Subuser[]
  auditLogs        AuditLog[]        @relation("AuditActor")
  createdSchedules Schedule[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  name       String   @db.VarChar(100)
  tokenHash  String   @unique
  scopes     String[]
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Node {
  id                String   @id @default(cuid())
  name              String   @db.VarChar(100)
  fqdn              String   @unique @db.VarChar(255)
  scheme            String   @default("https") @db.VarChar(5)
  daemonPort        Int      @default(8443)
  tokenHash         String
  certificateSha256 String?
  memoryBytes       BigInt
  diskBytes         BigInt
  cpuCores          Decimal  @db.Decimal(6, 2)
  isPublic          Boolean  @default(false)
  maintenance       Boolean  @default(false)
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  servers      Server[]
  allocations  Allocation[]
  auditLogs    AuditLog[]
}

model Allocation {
  id        String   @id @default(cuid())
  nodeId    String
  ipAddress String   @db.VarChar(45)
  port      Int
  alias     String?
  serverId  String?
  createdAt DateTime @default(now())

  node   Node    @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@unique([nodeId, ipAddress, port])
  @@index([serverId])
}

model Template {
  id          String     @id @default(cuid())
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  type        ServerType
  description String?
  version     String     @db.VarChar(32)
  specJson    Json
  variablesJson Json
  patchesJson Json       @default("[]")
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  servers     Server[]
  templateVariables TemplateVariable[]

  @@unique([slug, version])
}

model TemplateVariable {
  id           String       @id @default(cuid())
  templateId   String
  name         String       @db.VarChar(64)
  label        String       @db.VarChar(100)
  description  String?
  type         VariableType
  defaultValue String?
  required     Boolean      @default(false)
  rules        Json         @default("{}")
  sortOrder    Int          @default(0)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
}

model Server {
  id              String      @id @default(cuid())
  name            String      @db.VarChar(100)
  type            ServerType
  state           ServerState @default(OFFLINE)
  ownerId         String
  nodeId          String
  templateId      String
  templateVersion String      @db.VarChar(32)
  suspended       Boolean     @default(false)
  startupRevision Int         @default(1)
  memoryBytes     BigInt
  diskBytes       BigInt
  cpuPercent      Decimal     @db.Decimal(7, 2)
  swapBytes       BigInt      @default(0)
  pidsLimit       Int         @default(512)
  ioWeight        Int         @default(500)
  dockerImage     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  reinstalledAt   DateTime?

  owner       User         @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  node        Node         @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  template    Template     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  allocations Allocation[]
  variables   ServerVariable[]
  subusers    Subuser[]
  backups     Backup[]
  schedules   Schedule[]
  auditLogs   AuditLog[]

  @@index([ownerId])
  @@index([nodeId])
}

model ServerVariable {
  id        String   @id @default(cuid())
  serverId  String
  name      String   @db.VarChar(64)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
}

model Subuser {
  id          String   @id @default(cuid())
  serverId    String
  userId      String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model Backup {
  id           String        @id @default(cuid())
  serverId     String
  name         String        @db.VarChar(100)
  storage      BackupStorage
  state        BackupState   @default(CREATING)
  sizeBytes    BigInt        @default(0)
  objectKey    String?
  checksumSha256 String?
  locked       Boolean       @default(false)
  failedReason String?
  createdAt    DateTime      @default(now())
  completedAt  DateTime?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

model Schedule {
  id        String   @id @default(cuid())
  serverId  String
  createdBy String
  name      String   @db.VarChar(100)
  cron      String   @db.VarChar(100)
  timezone  String   @default("UTC") @db.VarChar(64)
  enabled   Boolean  @default(true)
  nextRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  tasks   ScheduleTask[]

  @@index([serverId])
  @@index([enabled, nextRunAt])
}

model ScheduleTask {
  id         String           @id @default(cuid())
  scheduleId String
  type       ScheduleTaskType
  payload    Json             @default("{}")
  sortOrder  Int              @default(0)
  continueOnError Boolean     @default(false)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, sortOrder])
}

model AuditLog {
  id          String       @id @default(cuid())
  actorId     String?
  serverId    String?
  nodeId      String?
  action      String       @db.VarChar(100)
  outcome     AuditOutcome
  ipAddress   String?
  userAgent   String?
  metadata    Json         @default("{}")
  requestId   String?      @db.VarChar(64)
  createdAt   DateTime     @default(now())

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  node   Node?   @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([serverId, createdAt])
  @@index([nodeId, createdAt])
}

model PanelSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
}
